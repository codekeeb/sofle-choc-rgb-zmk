DT_COMPAT_CODEKEEB_BATTERY_NRF_VDDH_CURVE := codekeeb,battery-nrf-vddh-curve

config CODEKEEB_BATTERY_NRF_VDDH_CURVE
    bool
    default $(dt_compat_enabled,$(DT_COMPAT_CODEKEEB_BATTERY_NRF_VDDH_CURVE))
    select ADC
    select ZMK_BATTERY
    depends on SENSOR
    help
      Driver de bateria por VDDH del nRF52 con curva de descarga LiPo
      realista en lugar de la aproximacion lineal de ZMK.

# --- RGB FX (efectos de animacion, codigo vendorizado de zmk-rgb-fx, MIT) ---

config ZMK_RGB_FX
    bool "RGB animation effects"
    depends on LED_STRIP
    help
      Sistema de animaciones RGB (ripple, sparkle, gradient, solid)
      que sustituye al underglow estandar de ZMK.

config ZMK_RGB_FX_FPS
    int "RGB effect FPS"
    range 1 60
    default 30
    depends on ZMK_RGB_FX

config ZMK_RGB_FX_PIXEL_DISTANCE
    bool "Pixel distance lookup table"
    default y
    depends on ZMK_RGB_FX
    help
      Tabla de distancias entre pixeles usada por el efecto ripple.

# --- Encoder rotation bindings editable en runtime via ZMK Studio ---
#
# Split in two: the behavior itself (ZMK_SENSOR_ROTATE_DYNAMIC) must
# compile on BOTH halves whenever the keymap references it in
# sensor-bindings -- sensor events are processed locally on whichever
# half the physical encoder lives on, same as stock sensor-rotate, so it
# does NOT depend on ZMK_STUDIO (the right half never builds with Studio
# in this repo, but its own encoder's rotation still has to work).
# The RPC subsystem that lets Studio read/write it over USB
# (ZMK_SENSOR_ROTATE_DYNAMIC_STUDIO) only makes sense -- and only
# compiles -- on the half that has Studio.

DT_COMPAT_ZMK_SENSOR_ROTATE_DYNAMIC := zmk,behavior-sensor-rotate-dynamic

config ZMK_SENSOR_ROTATE_DYNAMIC
    bool
    default $(dt_compat_enabled,$(DT_COMPAT_ZMK_SENSOR_ROTATE_DYNAMIC))
    select SETTINGS
    help
      Encoder (sensor) rotation bindings whose clockwise/counter-clockwise
      assignment can be read and rewritten at runtime (unlike stock ZMK's
      compile-time-only sensor-bindings) and persists via settings, same
      as regular keys. See ZMK_SENSOR_ROTATE_DYNAMIC_STUDIO for the half
      that also exposes this over ZMK Studio.

config ZMK_SENSOR_ROTATE_DYNAMIC_STUDIO
    bool
    default y
    depends on ZMK_SENSOR_ROTATE_DYNAMIC && ZMK_STUDIO
    help
      ZMK Studio RPC handlers (get_sensor_bindings, set_sensor_binding)
      for ZMK_SENSOR_ROTATE_DYNAMIC. Requires the fork
      codekeeb/zmk-studio-messages (see config/west.yml) with those
      request/response messages, which don't exist upstream.
